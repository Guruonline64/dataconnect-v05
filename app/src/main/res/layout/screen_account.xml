<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="@color/dc_bg">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="vertical" android:padding="20dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:text="Account" android:textSize="26sp" android:textStyle="bold"
   android:textColor="@color/dc_blue_dark"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:text="Profile and account settings" android:textSize="14sp" android:textColor="@color/dc_text"
   android:layout_marginTop="5dp" android:layout_marginBottom="18dp"/>
  <TextView android:id="@+id/screenStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="Loading..." android:textSize="16sp" android:textColor="@color/dc_text"
   android:padding="16dp" android:background="@color/dc_white"/>
 </LinearLayout>
</ScrollView>
